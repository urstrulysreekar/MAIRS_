# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# ── Model ─────────────────────────────────────────────────────
YOLO_WEIGHTS_PATH=./weights/best.pt
ONNX_MODEL_PATH=./weights/best.onnx

# ── Inference ─────────────────────────────────────────────────
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMG_SIZE=640

# ── Directories ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
